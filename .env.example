# Copy to .env and edit. Docker Compose reads .env automatically.

# Metashape version: "latest" or a specific version such as 2.1.3
METASHAPE_VERSION=2.1.3

# node       = join a Metashape cluster as a processing node
# standalone = idle container with a shell for running Metashape yourself
MODE=node

# Server (coordinator) IP the node connects to (node mode only)
METASHAPE_HOST=10.78.3.14

# Shared project folder on the host, mounted at /workspace
WORKSPACE_PATH=/mnt/p

# GPUs given to the container: "all" or a number (e.g. 1 = first GPU only)
GPU_COUNT=all
# Which of those GPUs Metashape uses, as a bitmask (1=first, 2=second, 3=both).
# Leave empty to use all of them.
GPU_MASK=
