#!/usr/bin/env bash
# Run the Metashape workflow (the msworkflow package next to this script) on the
# project in the current folder: logs everything to run.log and prints the exit
# code (0 = all done, 1 = a step failed, 130 = interrupted).
#
# A project folder holds processing_config.toml (start from
# processing_config.example.toml in this folder); results go where it says.
#
# Usage (from the project folder, or with PROJECT_DIR set to it):
#   run                       # nothing is run: shows the help
#   run --all                 # all the steps listed in [run] steps of processing_config.toml
#   run mesh texture export   # only these steps
#   run mesh --force          # rebuild the mesh even if it exists
#   run --config other.toml
# Arguments are passed on unchanged (run --help lists them).
#
# Environment:
#   PROJECT_DIR       project folder (default: the current folder)
#   METASHAPE_PYTHON  interpreter (default: python, i.e. the venv in /opt/venv)
set -uo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1  # log lines appear as they happen, also through tee

# no arguments, or -h/--help: show the help and run nothing (not logged to run.log)
py="${METASHAPE_PYTHON:-python}"
if [[ $# -eq 0 ]]; then "$py" -m msworkflow --help; exit 2; fi
for a in "$@"; do [[ $a == -h || $a == --help ]] && exec "$py" -m msworkflow --help; done

cd "${PROJECT_DIR:-$PWD}"
[[ -w . ]] || { echo "cannot write run.log in $PWD: cd to the project folder or set PROJECT_DIR" >&2; exit 2; }
echo "=== $(date '+%F %T') run $* (in $PWD)" >> run.log

"$py" -m msworkflow "$@" 2>&1 | tee -a run.log
code=${PIPESTATUS[0]}
echo "exit code: $code" | tee -a run.log
exit "$code"
